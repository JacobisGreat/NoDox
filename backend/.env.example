# NODOXX backend configuration
# Copy this file to .env and fill in your secrets.

# --- Gemini (Google AI Studio; sign up at https://aistudio.google.com) ---
# Free tier: ~10 RPM on 2.5-flash, no card required.
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash

# --- Serper.dev (web search; sign up at https://serper.dev) ---
# Free tier: 2500 searches on signup, no card required.
SERPER_API_KEY=

# --- Per-audit budgets (USD) ---
AUDIT_COST_CEILING_USD=1.0
WEB_FOOTPRINT_BUDGET_SHARE_USD=0.35
WEB_FOOTPRINT_MAX_QUERIES=15
WEB_FOOTPRINT_MAX_FULL_FETCHES=20

# --- Gemini price table ($ / million tokens) ---
GEMINI_PRO_INPUT_COST_PER_MILLION=1.25
GEMINI_PRO_OUTPUT_COST_PER_MILLION=10.0
GEMINI_FAST_INPUT_COST_PER_MILLION=0.30
GEMINI_FAST_OUTPUT_COST_PER_MILLION=2.50

# --- Instagram fetch ---
# Optional: paste a `sessionid` cookie value from a logged-in instagram.com
# tab to bypass the anonymous rate limit. Without this, anonymous lookups
# burn through IG's per-IP quota fast and start returning 401/403/429.
# Open instagram.com → DevTools → Application → Cookies → copy `sessionid`.
# IG_DS_USER_ID and IG_CSRFTOKEN are optional but improve reliability.
IG_SESSIONID=
IG_DS_USER_ID=
IG_CSRFTOKEN=

# --- App / session ---
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_NAME=shieldclaw_session
SESSION_TTL_MINUTES=120

# --- Web footprint (Workstream C) ---
# Optional: HaveIBeenPwned v3 API key (~$3.95/mo from haveibeenpwned.com/API/Key).
# When unset, breach checks are skipped (web_footprint emits an info status).
HIBP_API_KEY=
# Optional: IntelBase API key (https://intelbase.is). When set, web_footprint
# enriches each discovered email with breach + linked-account intelligence.
INTELBASE_API_KEY=
ACCOUNT_PROBE_ENABLED=true
ACCOUNT_PROBE_MAX_CONCURRENT=8

# --- Geolocation (Workstream B) ---
# Force CPU even if CUDA is available. Set to "cpu" to disable GPU usage,
# leave empty to auto-detect.
NODOXX_GEOCLIP_DEVICE=
