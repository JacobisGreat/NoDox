APP_NAME=NoDox API
ENVIRONMENT=development

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

SESSION_COOKIE_NAME=nodox_session
SESSION_TTL_MINUTES=120
SESSION_COOKIE_SECURE=false

INSTAGRAM_GRAPH_API_BASE=https://graph.instagram.com

ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6

AUDIT_COST_CEILING_USD=1.0
CLAUDE_HAIKU_INPUT_COST_PER_MILLION=1.0
CLAUDE_HAIKU_OUTPUT_COST_PER_MILLION=5.0
CLAUDE_SONNET_INPUT_COST_PER_MILLION=3.0
CLAUDE_SONNET_OUTPUT_COST_PER_MILLION=15.0

META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/auth/meta/callback
META_SCOPE=instagram_graph_user_profile,instagram_graph_user_media
META_AUTH_URL=https://api.instagram.com/oauth/authorize
META_TOKEN_URL=https://api.instagram.com/oauth/access_token
META_GRAPH_BASE_URL=https://graph.instagram.com
META_EXCHANGE_LONG_LIVED_TOKEN=false
META_LONG_LIVED_TOKEN_URL=https://graph.instagram.com/access_token

GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
