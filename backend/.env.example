# NODOXX backend configuration
# Copy this file to .env and fill in your secrets.

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# --- Google Programmable Search ---
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Per-audit budgets (USD) ---
AUDIT_COST_CEILING_USD=1.0
WEB_FOOTPRINT_BUDGET_SHARE_USD=0.35
WEB_FOOTPRINT_MAX_QUERIES=15
WEB_FOOTPRINT_MAX_FULL_FETCHES=20

# --- Anthropic price table ($ / million tokens) ---
CLAUDE_SONNET_INPUT_COST_PER_MILLION=3.0
CLAUDE_SONNET_OUTPUT_COST_PER_MILLION=15.0
CLAUDE_HAIKU_INPUT_COST_PER_MILLION=1.0
CLAUDE_HAIKU_OUTPUT_COST_PER_MILLION=5.0

# --- App / session ---
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_NAME=shieldclaw_session
SESSION_TTL_MINUTES=120
